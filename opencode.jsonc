{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*":                  "ask",  // wild card
    "read": { // reading a file (matches the file path)
        "*": "ask",
        "**/.tmp/nvim99/99-*": "allow",
        ".tmp/nvim99/99-*": "allow",
        "*.env": "deny",
        "*.env.*": "deny"
    },
    "edit": { // all file modifications (covers edit, write, patch, multiedit)
        "*": "ask",
        "**/.tmp/nvim99/99-*": "allow",
        ".tmp/nvim99/99-*": "allow",
        "*.env": "deny",
        "*.env.*": "deny"
    },  
    //"glob":               "ask",  // file globbing (matches the glob pattern)
    //"grep":               "ask",  // content search (matches the regex pattern)
    //"list":               "ask",  // listing files in a directory (matches the directory path)
    "bash": { // running shell commands (matches parsed commands like git status --porcelain)              
        "*": "ask",
        "ls -la .tmp/nvim99/": "allow",
        "ls -la ./.tmp/nvim99/": "allow",
        "mkdir -p .tmp/nvim99": "allow",
        "mkdir -p ./.tmp/nvim99": "allow"
    },
    //"task":               "ask",  // launching subagents (matches the subagent type)
    //"skill":              "ask",  // loading a skill (matches the skill name)
    //"lsp":                "ask",  // running LSP queries (currently non-granular)
    //"todoread":           "ask",  // reading the todo list
    //"todowrite":          "ask",  // updating the todo list
    //"webfetch":           "ask",  // fetching a URL (matches the URL)
    //"websearch":          "ask",  // fetching a URL (matches the URL)
    //"codesearch":         "ask",  // code search (matches the query)
    "external_directory": "deny"  
    //{ // triggered when a tool touches paths outside the project working directory
    //     "*": "ask",
    // } 
    //"doom_loop":          "ask"   // triggered when the same tool call repeats 3 times with identical input
  }
}

